# Copy these names into Railway → Backend service → Variables.
# Replace placeholders with real values in Railway. Never commit real secrets.
APP_ENV=production
TELEGRAM_MODE=webhook
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
ARCHIVE_API_KEY=REPLACE_WITH_RANDOM_API_KEY
APP_BASE_URL=https://YOUR-BACKEND-DOMAIN.up.railway.app
FRONTEND_ORIGIN=https://hang8s.github.io
MINI_APP_URL=https://hang8s.github.io/EYE_NEMO_FRONTEND/
MINI_APP_AUTH_MAX_AGE_SECONDS=3600
MEDIA_STORAGE=none
MEDIA_PATH=/data/media
LOG_LEVEL=INFO
# Railway supplies PORT automatically; do not add APP_PORT.
